# Anclora Nexus (portal del agente y endpoint de leads)
# En desarrollo, apunta estas URLs a tu instancia local de anclora-nexus.
VITE_ANCLORA_NEXUS_LOGIN_URL=http://localhost:3000/login
VITE_ANCLORA_PRIVATE_AREA_URL=http://localhost:3000
VITE_ANCLORA_PARTNER_PORTAL_URL=http://localhost:3000/private-area/partner
VITE_ANCLORA_DATA_LAB_URL=http://localhost:3000/private-area/data-lab
VITE_ANCLORA_NEXUS_PUBLIC_LEAD_URL=http://localhost:8000/api/public/cta/lead

# Compatibilidad con nombres legacy (opcional)
# VITE_NEXUS_LOGIN_URL=http://localhost:3000/login
# VITE_NEXUS_PUBLIC_LEAD_URL=http://localhost:8000/api/public/cta/lead

# CAPTCHA canónico del formulario de contacto: Cloudflare Turnstile.
# The public site key is safe for the browser; the verification secret belongs only to Nexus.
VITE_CONTACT_CAPTCHA_PROVIDER=turnstile
VITE_TURNSTILE_SITE_KEY=
